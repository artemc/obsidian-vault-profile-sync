{
  "name": "vault-profile-sync",
  "version": "0.1.0",
  "description": "Share one profile of plugins, settings, hotkeys, snippets and appearance across many Obsidian vaults via a GitHub repository.",
  "main": "main.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "tslib": "^2.9.1",
    "typescript": "5.9",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "diff": "^9.0.0"
  }
}
